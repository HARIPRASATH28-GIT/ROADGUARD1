# RoadGuard AI - Environment Configuration

# OpenWeather API (Leave blank to use built-in realistic mock/cached weather fallback)
OPENWEATHER_API_KEY=

# OpenStreetMap Overpass API (Defaults to public Overpass endpoint with local caching)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Backend Server
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Security & Guardrails
AUTH_SECRET_KEY=roadguard-ai-secret-key-super-secure-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI / Vision settings
YOLO_MODEL=yolov8n.pt
ANONYMIZE_FACES_PLATES=True
DISABLE_IDENTITY_STORAGE=True
DEMO_MODE=True
